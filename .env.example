# Debug configuration
# Copy this file to .env and modify as needed
# Set to true to enable debug features in development

# Master debug switch
VITE_DEBUG_ENABLED=false

# Show camera position and target overlay
VITE_DEBUG_SHOW_CAMERA_INFO=false

# Show center screen dot for alignment
VITE_DEBUG_SHOW_CENTER_DOT=false

# Show liver inscription green spheres around the centers (camera target)
VITE_DEBUG_LIVER_INSCRIPTION=false

# Show liver bounding boxes
VITE_DEBUG_LIVER_BOUNDING_BOX=false
