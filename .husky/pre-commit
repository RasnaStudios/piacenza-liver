echo "🔍 Checking staged files with Biome..."
pnpm biome check --staged --no-errors-on-unmatched

if [ $? -ne 0 ]; then
    echo "❌ Lint check failed! Please run 'pnpm lint:fix' to fix the errors before committing."
    exit 1
fi

pnpm tsc

if [ $? -ne 0 ]; then
    echo "❌ Type check failed! Please fix the errors before committing."
    exit 1
fi

echo "✅ Code formatted and linted successfully!"
