precision mediump float;

uniform sampler2D diffuseTexture;
uniform sampler2D normalTexture;
uniform sampler2D maskTexture;
uniform sampler2D ormTexture; // R: AO, G: Roughness, B: Metallic
uniform float time;
uniform int hoveredInscription;
uniform int uvMode; // 0: as-is, 1: flipV, 2: rotate 90 cw, 3: rotate 90 ccw
uniform float normalScale; // 0..1
uniform float flipNormalY; // +1 or -1

varying vec2 vUv;
varying vec3 vPosition;
varying vec3 vNormal;
varying vec3 vViewPos;

{{INSCRIPTION_COLOR_FUNCTION}}

vec2 mapUV(vec2 uv) {
  if (uvMode == 1) {
    return vec2(uv.x, 1.0 - uv.y);
  } else if (uvMode == 2) { // rotate 90 cw
    return vec2(uv.y, 1.0 - uv.x);
  } else if (uvMode == 3) { // rotate 90 ccw
    return vec2(1.0 - uv.y, uv.x);
  }
  return uv;
}

float detectBorder(vec2 uv, float pixelSize) {
  // uv is already mapped; do not map again
  float centerId = texture2D(maskTexture, uv).r * 255.0;
  
  float neighbors[8];
  neighbors[0] = texture2D(maskTexture, vec2(uv.x - pixelSize, uv.y - pixelSize)).r * 255.0;
  neighbors[1] = texture2D(maskTexture, vec2(uv.x, uv.y - pixelSize)).r * 255.0;
  neighbors[2] = texture2D(maskTexture, vec2(uv.x + pixelSize, uv.y - pixelSize)).r * 255.0;
  neighbors[3] = texture2D(maskTexture, vec2(uv.x - pixelSize, uv.y)).r * 255.0;
  neighbors[4] = texture2D(maskTexture, vec2(uv.x + pixelSize, uv.y)).r * 255.0;
  neighbors[5] = texture2D(maskTexture, vec2(uv.x - pixelSize, uv.y + pixelSize)).r * 255.0;
  neighbors[6] = texture2D(maskTexture, vec2(uv.x, uv.y + pixelSize)).r * 255.0;
  neighbors[7] = texture2D(maskTexture, vec2(uv.x + pixelSize, uv.y + pixelSize)).r * 255.0;
  
  float borderStrength = 0.0;
  for (int i = 0; i < 8; i++) {
    if (abs(neighbors[i] - centerId) > 0.5) {
      borderStrength = 1.0;
      break;
    }
  }
  
  return borderStrength;
}

void main() {
  // Map UVs according to switch
  vec2 uv = mapUV(vUv);
  
  vec4 diffuseColor = texture2D(diffuseTexture, uv);

  // Normal mapping with derivative-based TBN in view space
  vec3 N = normalize(vNormal);
  vec3 nMap = texture2D(normalTexture, uv).rgb * 2.0 - 1.0;
  nMap.y *= (flipNormalY >= 0.0 ? 1.0 : -1.0);
  
  vec3 dp1 = dFdx(vViewPos);
  vec3 dp2 = dFdy(vViewPos);
  vec2 duv1 = dFdx(uv);
  vec2 duv2 = dFdy(uv);
  
  vec3 T = normalize(dp1 * duv2.y - dp2 * duv1.y);
  vec3 B = normalize(dp2 * duv1.x - dp1 * duv2.x);
  mat3 TBN = mat3(T, B, N);
  
  vec3 normal = normalize(mix(N, normalize(TBN * nMap), clamp(normalScale, 0.0, 1.0)));
  
  vec3 lightDir = normalize(vec3(0.5, 1.0, 0.5));
  float NdotL = max(dot(normal, lightDir), 0.0);
  
  vec4 maskColor = texture2D(maskTexture, uv);
  vec3 orm = texture2D(ormTexture, uv).rgb;
  float ao = orm.r;
  float roughness = clamp(orm.g, 0.04, 1.0);
  float metallic = orm.b;
  
  float grayValue = maskColor.r;
  int inscriptionId = int(grayValue * 255.0 + 0.5);
  
  // Bright lambert + ambient, mild AO
  float ambient = 0.85;
  float diffuse = 1.0 * NdotL;
  vec3 lit = diffuseColor.rgb * (ambient + diffuse);
  lit *= mix(1.0, ao, 0.15);
  
  // Simple specular driven by roughness/metallic
  vec3 V = normalize(-vViewPos);
  vec3 H = normalize(V + lightDir);
  float specPow = mix(8.0, 64.0, 1.0 - roughness);
  float spec = pow(max(dot(normal, H), 0.0), specPow);
  vec3 specCol = mix(vec3(0.04), diffuseColor.rgb, metallic);
  lit += spec * specCol * 0.25;
  vec3 finalColor = lit;
  
  float pixelSize = 1.0 / 4096.0;
  float borderStrength = detectBorder(uv, pixelSize);
  
  if (borderStrength > 0.0 && inscriptionId > 0 && inscriptionId <= 42) {
    vec3 regionColor = getInscriptionColor(inscriptionId);
    
    float glow = sin(time * 3.0) * 0.3 + 0.7;
    vec3 borderColor = mix(regionColor, vec3(1.0, 1.0, 1.0), 0.3);
    finalColor = mix(finalColor, borderColor, borderStrength * glow * 0.15);
  }
  
  if (inscriptionId > 0 && inscriptionId <= 42 && inscriptionId == hoveredInscription) {
    vec3 groupColor = getInscriptionColor(inscriptionId);
    
    float shimmer = sin(time * 8.0) * 0.3 + 0.7;
    vec3 shimmerColor = mix(groupColor, vec3(1.0, 1.0, 1.0), 0.5);
    finalColor = mix(finalColor, shimmerColor, shimmer * 0.1);
    
    float pulse = sin(time * 4.0) * 0.2 + 0.8;
    finalColor = mix(finalColor, finalColor * pulse, 0.1);
    
    finalColor = mix(finalColor, groupColor, 0.1);
    finalColor = mix(finalColor, groupColor * 1.8, 0.1);
  }
  
  gl_FragColor = vec4(finalColor, diffuseColor.a);
}