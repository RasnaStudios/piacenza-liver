precision mediump float;

uniform sampler2D diffuseTexture;
uniform sampler2D normalTexture;
uniform sampler2D maskTexture;
uniform sampler2D ormTexture; // R: AO, G: Roughness, B: Metallic
uniform float time;
uniform int hoveredInscription;
uniform int selectedInscription;
uniform int uvMode; // 0: as-is, 1: flipV, 2: rotate 90 cw, 3: rotate 90 ccw
uniform float normalScale; // 0..1
uniform float flipNormalY; // +1 or -1
uniform float useORM; // 0..1 gate for ORM influence
uniform float ambientStrength; // overall ambient intensity
uniform vec3 lightDirectionWorld; // input from TS, transformed to view space here
uniform float useNormal; // 0 off, 1 on

varying vec2 vUv;
varying vec3 vNormal;
varying vec3 vViewPos;

{{INSCRIPTION_COLOR_FUNCTION}}

vec2 mapUV(vec2 uv) {
  if (uvMode == 1) {
    return vec2(uv.x, 1.0 - uv.y);
  } else if (uvMode == 2) { // rotate 90 cw
    return vec2(uv.y, 1.0 - uv.x);
  } else if (uvMode == 3) { // rotate 90 ccw
    return vec2(1.0 - uv.y, uv.x);
  }
  return uv;
}

float detectBorder(vec2 uv, float pixelSize) {
  // uv is already mapped; do not map again
  float centerId = texture2D(maskTexture, uv).r * 255.0;
  
  float neighbors[8];
  neighbors[0] = texture2D(maskTexture, vec2(uv.x - pixelSize, uv.y - pixelSize)).r * 255.0;
  neighbors[1] = texture2D(maskTexture, vec2(uv.x, uv.y - pixelSize)).r * 255.0;
  neighbors[2] = texture2D(maskTexture, vec2(uv.x + pixelSize, uv.y - pixelSize)).r * 255.0;
  neighbors[3] = texture2D(maskTexture, vec2(uv.x - pixelSize, uv.y)).r * 255.0;
  neighbors[4] = texture2D(maskTexture, vec2(uv.x + pixelSize, uv.y)).r * 255.0;
  neighbors[5] = texture2D(maskTexture, vec2(uv.x - pixelSize, uv.y + pixelSize)).r * 255.0;
  neighbors[6] = texture2D(maskTexture, vec2(uv.x, uv.y + pixelSize)).r * 255.0;
  neighbors[7] = texture2D(maskTexture, vec2(uv.x + pixelSize, uv.y + pixelSize)).r * 255.0;
  
  float borderStrength = 0.0;
  for (int i = 0; i < 8; i++) {
    if (abs(neighbors[i] - centerId) > 0.5) {
      borderStrength = 1.0;
      break;
    }
  }
  
  return borderStrength;
}

void main() {
  // Raw UVs for PBR textures; apply mapping only to segmentation mask
  vec2 uvBase = vUv;
  vec2 uvMask = mapUV(vUv);

  // Base color already in linear color space
  vec4 base_srgb = texture2D(diffuseTexture, uvBase);
  vec3 baseLinear = base_srgb.rgb;

  // Normal mapping in view space via derivative-based TBN (guarded by useNormal)
  vec3 N = normalize(vNormal);
  vec3 normal = N;
  if (useNormal > 0.5) {
    vec3 nMap = texture2D(normalTexture, uvBase).rgb * 2.0 - 1.0;
    nMap.y *= (flipNormalY >= 0.0 ? 1.0 : -1.0);

    vec3 dp1 = dFdx(vViewPos);
    vec3 dp2 = dFdy(vViewPos);
    vec2 duv1 = dFdx(uvBase);
    vec2 duv2 = dFdy(uvBase);
    vec3 T = normalize(dp1 * duv2.y - dp2 * duv1.y);
    vec3 B = normalize(dp2 * duv1.x - dp1 * duv2.x);
    mat3 TBN = mat3(T, B, N);
    normal = normalize(mix(N, normalize(TBN * nMap), clamp(normalScale, 0.0, 1.0)));
  }

  // Simple direct light (transform world-space input into view space)
  vec3 lightDir = normalize((viewMatrix * vec4(lightDirectionWorld, 0.0)).xyz);
  float NdotL = max(dot(normal, lightDir), 0.0);

  // ORM sampling
  vec3 orm = texture2D(ormTexture, uvBase).rgb;
  float ao = mix(1.0, orm.r, useORM);
  float roughness = mix(0.6, orm.g, useORM);
  float metallic = mix(0.0, orm.b, useORM);

  // Ambient + diffuse; AO attenuates both
  float aoStrong = ao * ao;
  vec3 ambient = baseLinear * ambientStrength * aoStrong; // soft ambient
  vec3 lit = ambient + baseLinear * (NdotL * aoStrong);

  // Specular term shaped by roughness/metallic (view space)
  vec3 V = normalize(-vViewPos);
  vec3 H = normalize(V + lightDir);
  float specPow = mix(8.0, 64.0, (1.0 - roughness) * (1.0 - roughness));
  float spec = pow(max(dot(normal, H), 0.0), specPow);
  vec3 specCol = mix(vec3(0.04), baseLinear, metallic);
  float specIntensity = 0.10 * (1.0 - roughness) * (1.0 - roughness) * mix(0.3, 1.0, metallic);
  lit += spec * specCol * specIntensity;

  vec3 finalColor = lit;

  // Selection + hover tint applied LAST; both can apply simultaneously
  vec4 maskColor = texture2D(maskTexture, uvMask);
  int inscriptionId = int(maskColor.r * 255.0 + 0.5);
  if (inscriptionId > 0 && inscriptionId <= 42) {
    bool isSel = (selectedInscription > 0 && inscriptionId == selectedInscription);
    bool isHover = (hoveredInscription > 0 && inscriptionId == hoveredInscription);

    if (isSel) {
      vec3 selColor = getInscriptionColor(inscriptionId);
      // Very slow pulse (~12.5s period)
      float pulse = 0.5 + 0.5 * sin(time * 0.5);
      float intensity = 0.25 + 0.35 * pulse; // stronger than hover
      // Additive color boost (no white), preserves texture details, increases contrast
      finalColor += selColor * intensity;
    }

    if (isHover && !isSel) {
      vec3 hoverColor = getInscriptionColor(inscriptionId);
      // Subtle additive tint to avoid washing out base
      finalColor += hoverColor * 0.18;
    }
  }

  gl_FragColor = vec4(clamp(finalColor, 0.0, 1.0), base_srgb.a);
}