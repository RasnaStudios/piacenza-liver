{
	"name": "piacenza-liver",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build:extract": "tsx scripts/extract-inscriptions.ts",
		"build": "npm run build:extract && vite build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"serve": "serve dist -s",
		"prepare": "husky"
	},
	"biome": {
		"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
		"vcs": {
			"enabled": true,
			"clientKind": "git",
			"useIgnoreFile": true
		},
		"files": {
			"ignoreUnknown": true,
			"includes": [
				"src/**/*",
				"*.ts",
				"*.tsx",
				"*.js",
				"*.jsx"
			],
			"ignore": [
				"scripts/**/*",
				"dist/**/*",
				"node_modules/**/*",
				"public/data/**/*",
				"*.py",
				"venv/**/*",
				".venv/**/*",
				".husky/**/*",
				"prepare/**/*",
				"pre-push/**/*",
				"*.xml",
				"*.svg",
				"LICENSE",
				"CNAME",
				"robots.txt",
				"sitemap.xml",
				".env*",
				"*.lock",
				"pnpm-lock.yaml"
			]
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "space",
			"indentWidth": 2
		},
		"linter": {
			"enabled": true,
			"rules": {
				"recommended": true,
				"correctness": {
					"noUnusedVariables": "error",
					"useExhaustiveDependencies": "off"
				},
				"suspicious": {
					"noExplicitAny": "warn"
				},
				"style": {
					"noNonNullAssertion": "warn",
					"noApproximativeNumericConstant": "off"
				}
			}
		},
		"javascript": {
			"formatter": {
				"quoteStyle": "single",
				"semicolons": "always",
				"trailingCommas": "es5"
			}
		},
		"json": {
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		"assist": {
			"enabled": true,
			"actions": {
				"source": {
					"organizeImports": "on"
				}
			}
		}
	},
	"lint-staged": {
		"src/**/*.{ts,tsx,js,jsx}": [
			"biome format --write"
		],
		"*.{json,md}": [
			"biome format --write"
		]
	},
	"dependencies": {
		"@mantine/core": "^8.3.10",
		"@mantine/hooks": "^8.3.10",
		"@tabler/icons-react": "^3.36.0",
		"@use-gesture/react": "^10.3.1",
		"gsap": "^3.14.2",
		"react": "^19.2.3",
		"react-device-detect": "^2.2.3",
		"react-dom": "^19.2.3",
		"react-icons": "^5.5.0",
		"three": "^0.182.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.182.0",
		"@vitejs/plugin-react": "^5.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"serve": "^14.2.5",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vite-plugin-pwa": "^1.2.0",
		"workbox-build": "^7.4.0",
		"workbox-window": "^7.4.0"
	}
}
